# Copy this file to .env and fill it in. Never commit .env.

# --- App ---
PORT=3000
# The address where the app is reachable on the internet, e.g. https://sales.example.com
PUBLIC_URL=http://localhost:3000
# Password for the dashboard (any user name works)
DASHBOARD_PASSWORD=
DATABASE_PATH=data/sales-agent.sqlite
# Optional: a WhatsApp number (country code, no +) that also gets the owner alerts (approvals, orders, hand-overs).
# Alerts always appear on the dashboard. Use a number other than the business number itself.
OWNER_PHONE=

# --- Claude (https://console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- WhatsApp Cloud API (Meta developer app -> WhatsApp -> API setup) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: the "Messaging account ID" shown next to the phone number in Meta's API setup (for the dashboard's check)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App settings -> Basic -> App secret (used to check webhook calls really come from Meta)
WHATSAPP_APP_SECRET=
# Any secret word; type the same word in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Approved message templates, needed to message someone more than 24 hours after their last message
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=en
WHATSAPP_SUPPLIER_TEMPLATE=
WHATSAPP_SUPPLIER_TEMPLATE_LANGUAGE=en

# --- Price list: "excel" or "zoho" ---
CATALOG_SOURCE=excel
EXCEL_PATH=data/price-list.xlsx
# Leave empty to use the first sheet
EXCEL_SHEET=

# --- Zoho (optional; also creates estimates in Zoho when set, even with an Excel price list) ---
# Create a "Self Client" at https://api-console.zoho.com and generate a refresh token with scopes:
# ZohoBooks.fullaccess.all  (or ZohoInventory.fullaccess.all)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# books or inventory
ZOHO_APP=books
# zoho.com, zoho.in, zoho.eu, zoho.com.au, zoho.sa ... (the one in your Zoho web address)
ZOHO_DOMAIN=zoho.com

# --- Email to suppliers (optional) ---
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
