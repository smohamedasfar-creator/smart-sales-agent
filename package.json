{
  "name": "smart-sales-agent",
  "version": "0.1.0",
  "description": "Multi-agent WhatsApp sales assistant: reads customer enquiries, checks Excel or Zoho prices and stock, asks suppliers, adds margin, sends estimates and follows up.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-public.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sample-price-list": "node scripts/make-sample-price-list.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
